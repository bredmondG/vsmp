# Configuration for the vsmp-web systemd unit (the status web server).
# Install to /etc/default/vsmp-web  (the path named by EnvironmentFile= in the
# unit). It is optional -- the unit ships working defaults -- but copy it if you
# want to change the port, restrict the bind address, or tune the page.
#
# Apply changes with:  sudo systemctl restart vsmp-web
# No daemon-reload needed -- this file is read at service start, not by systemd.

# ---------------------------------------------------------------------------
# Where gunicorn listens, as HOST:PORT.
#
#   0.0.0.0:8080   all interfaces -- reachable from any device on the LAN.
#                  This is the default and the usual choice on a trusted home
#                  network.
#   127.0.0.1:8080 localhost only -- use this if you put a reverse proxy
#                  (nginx/caddy) or an SSH tunnel in front of it.
# ---------------------------------------------------------------------------
VSMP_WEB_BIND="0.0.0.0:8080"

# ---------------------------------------------------------------------------
# The player's state file, as read by the web server. Relative paths resolve
# against WorkingDirectory (the repo), so the default matches what the player
# writes. Set an absolute path only if you moved state.json elsewhere.
# ---------------------------------------------------------------------------
#VSMP_STATE="state.json"

# ---------------------------------------------------------------------------
# How often the page reloads itself, in seconds. Frames change only every 150s
# (24/hour), so the default of 30 is already generous. Set 0 to disable the
# auto-refresh entirely.
# ---------------------------------------------------------------------------
#VSMP_WEB_REFRESH="30"

# ---------------------------------------------------------------------------
# The image-upload queue directory. The /upload page converts an uploaded photo
# to an 800x480 grayscale PNG and publishes it here; the player drains this same
# directory one image per 150s tick.
#
# This MUST be the SAME directory the player's --queue-dir / VSMP_QUEUE points
# at (see systemd/vsmp.env.example). If the two processes disagree, uploads land
# somewhere the player never reads and are never shown. Use an absolute path so
# both units resolve it identically regardless of WorkingDirectory. The web unit
# needs WRITE access to it -- see ReadWritePaths in systemd/vsmp-web.service.
# ---------------------------------------------------------------------------
VSMP_QUEUE="/home/pi/vsmp/queue"

# ---------------------------------------------------------------------------
# Optional archive of shown images. By default the player DELETES an image once
# its 150s slot is over. Set VSMP_ARCHIVE_DIR to keep a copy instead; the player
# moves each shown image there and prunes to the most-recent VSMP_ARCHIVE_MAX
# files (default 50) so the archive is always capped. These are read by the
# PLAYER, but documented here too so both units can be configured together. Off
# by default -- uncomment to enable.
# ---------------------------------------------------------------------------
#VSMP_ARCHIVE_DIR="/home/pi/vsmp/archive"
#VSMP_ARCHIVE_MAX="50"

# ---------------------------------------------------------------------------
# Upload authentication, DISABLED by default. Leave unset for a trusted LAN. If
# set, POST /upload requires the same secret in an X-Upload-Secret header or a
# 'secret' form/query field, else 403. This is the single knob to turn on before
# exposing uploads beyond the LAN (and even then, prefer a reverse proxy with
# TLS -- see DEPLOY-WEB.md "A note on access").
# ---------------------------------------------------------------------------
#VSMP_UPLOAD_SECRET="change-me"
