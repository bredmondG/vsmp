# Configuration for the vsmp-web systemd unit (the status web server).
# Install to /etc/default/vsmp-web  (the path named by EnvironmentFile= in the
# unit). It is optional -- the unit ships working defaults -- but copy it if you
# want to change the port, restrict the bind address, or tune the page.
#
# Apply changes with:  sudo systemctl restart vsmp-web
# No daemon-reload needed -- this file is read at service start, not by systemd.

# ---------------------------------------------------------------------------
# Where gunicorn listens, as HOST:PORT.
#
#   0.0.0.0:8080   all interfaces -- reachable from any device on the LAN.
#                  This is the default and the usual choice on a trusted home
#                  network.
#   127.0.0.1:8080 localhost only -- use this if you put a reverse proxy
#                  (nginx/caddy) or an SSH tunnel in front of it.
# ---------------------------------------------------------------------------
VSMP_WEB_BIND="0.0.0.0:8080"

# ---------------------------------------------------------------------------
# The player's state file, as read by the web server. Relative paths resolve
# against WorkingDirectory (the repo), so the default matches what the player
# writes. Set an absolute path only if you moved state.json elsewhere.
# ---------------------------------------------------------------------------
#VSMP_STATE="state.json"

# ---------------------------------------------------------------------------
# How often the page reloads itself, in seconds. Frames change only every 150s
# (24/hour), so the default of 30 is already generous. Set 0 to disable the
# auto-refresh entirely.
# ---------------------------------------------------------------------------
#VSMP_WEB_REFRESH="30"
